{
  "info": {
    "name": "Tarea 1 - API Departamentos (AdventureWorks2025)",
    "description": "Coleccion de pruebas de la API REST del curso Bases de Datos II. Los escenarios estan en orden: ejecutarlos de arriba hacia abajo. El escenario 2 guarda el id creado en la variable departmentId y los escenarios 3 y 4 lo reutilizan.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "departmentId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Estado del servicio",
      "item": [
        {
          "name": "GET health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Verifica que la API responde y que hay conexion con SQL Server. Devuelve 503 si la base esta caida."
          }
        }
      ]
    },
    {
      "name": "1. Estado inicial",
      "item": [
        {
          "name": "GET lista de departamentos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/departments?offset=0&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["departments"],
              "query": [
                { "key": "offset", "value": "0" },
                { "key": "limit", "value": "50" }
              ]
            },
            "description": "Los 16 departamentos originales de AdventureWorks. El total aparece en meta.total."
          }
        },
        {
          "name": "GET lista filtrada por nombre",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/departments?search=Production",
              "host": ["{{baseUrl}}"],
              "path": ["departments"],
              "query": [{ "key": "search", "value": "Production" }]
            },
            "description": "Filtro parcial por nombre o grupo: devuelve Production y Production Control."
          }
        },
        {
          "name": "GET departamento por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/departments/1",
              "host": ["{{baseUrl}}"],
              "path": ["departments", "1"]
            },
            "description": "Consulta puntual del departamento Engineering."
          }
        }
      ]
    },
    {
      "name": "2. Crear departamento (INSERT)",
      "item": [
        {
          "name": "POST crear departamento",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda el id generado para los escenarios 3 y 4.",
                  "if (pm.response.code === 201) {",
                  "    const id = pm.response.json().data.DepartmentID;",
                  "    pm.collectionVariables.set('departmentId', id);",
                  "    console.log('Departamento creado con id ' + id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"Name\": \"Investigación y Desarrollo TEC\",\n    \"GroupName\": \"Research and Development\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/departments", "host": ["{{baseUrl}}"], "path": ["departments"] },
            "description": "Crea un departamento. Responde 201 con la cabecera Location y guarda el id en la variable departmentId."
          }
        },
        {
          "name": "GET del recien creado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/departments/{{departmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["departments", "{{departmentId}}"]
            },
            "description": "Confirma que el departamento quedo guardado."
          }
        }
      ]
    },
    {
      "name": "3. Actualizar departamento (UPDATE)",
      "item": [
        {
          "name": "PUT actualizar departamento",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"Name\": \"I+D TEC Cartago\",\n    \"GroupName\": \"Research and Development\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/departments/{{departmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["departments", "{{departmentId}}"]
            },
            "description": "Cambia el nombre del departamento creado. Devuelve el registro ya actualizado."
          }
        },
        {
          "name": "GET verificando el cambio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/departments/{{departmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["departments", "{{departmentId}}"]
            },
            "description": "El nombre y la fecha de modificacion cambiaron."
          }
        }
      ]
    },
    {
      "name": "4. Borrar departamento (DELETE exitoso)",
      "item": [
        {
          "name": "DELETE del departamento creado",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/departments/{{departmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["departments", "{{departmentId}}"]
            },
            "description": "Se borra sin problema porque no tiene empleados en su historial. Responde 204 sin cuerpo."
          }
        },
        {
          "name": "GET confirmando el borrado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/departments/{{departmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["departments", "{{departmentId}}"]
            },
            "description": "Ya no existe: responde 404."
          }
        }
      ]
    },
    {
      "name": "5. Borrado rechazado por llave foranea",
      "item": [
        {
          "name": "DELETE Engineering (409)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/departments/1",
              "host": ["{{baseUrl}}"],
              "path": ["departments", "1"]
            },
            "description": "Engineering tiene empleados en EmployeeDepartmentHistory. El SP detecta el error 547 y la API responde 409 con un mensaje legible, no un 500."
          }
        }
      ]
    },
    {
      "name": "6. Consulta con JOIN",
      "item": [
        {
          "name": "GET empleados activos del departamento",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/departments/8/employees",
              "host": ["{{baseUrl}}"],
              "path": ["departments", "8", "employees"],
              "query": []
            },
            "description": "Empleados activos de Production Control con nombre completo, cargo, turno y fecha de ingreso. Cruza Department, EmployeeDepartmentHistory, Employee, Person y Shift."
          }
        },
        {
          "name": "GET empleados incluyendo historial",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/departments/1/employees?activos=false",
              "host": ["{{baseUrl}}"],
              "path": ["departments", "1", "employees"],
              "query": [{ "key": "activos", "value": "false" }]
            },
            "description": "Con activos=false aparecen tambien los empleados que ya salieron del departamento, con su fecha de salida."
          }
        }
      ]
    },
    {
      "name": "7. Casos de validacion y error",
      "item": [
        {
          "name": "POST nombre vacio (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"Name\": \"   \",\n    \"GroupName\": \"Pruebas\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/departments", "host": ["{{baseUrl}}"], "path": ["departments"] },
            "description": "El nombre es obligatorio."
          }
        },
        {
          "name": "POST nombre de mas de 50 caracteres (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"Name\": \"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\n    \"GroupName\": \"Pruebas\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/departments", "host": ["{{baseUrl}}"], "path": ["departments"] },
            "description": "La columna Name admite maximo 50 caracteres."
          }
        },
        {
          "name": "POST nombre duplicado (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"Name\": \"Engineering\",\n    \"GroupName\": \"Pruebas\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/departments", "host": ["{{baseUrl}}"], "path": ["departments"] },
            "description": "El nombre del departamento es unico (indice AK_Department_Name)."
          }
        },
        {
          "name": "GET id inexistente (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/departments/9999",
              "host": ["{{baseUrl}}"],
              "path": ["departments", "9999"]
            },
            "description": "No existe el departamento 9999."
          }
        },
        {
          "name": "GET id no numerico (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/departments/abc",
              "host": ["{{baseUrl}}"],
              "path": ["departments", "abc"]
            },
            "description": "El id debe ser un numero entero entre 1 y 32767."
          }
        },
        {
          "name": "PUT id inexistente (404)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"Name\": \"No existe\",\n    \"GroupName\": \"Pruebas\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/departments/9999",
              "host": ["{{baseUrl}}"],
              "path": ["departments", "9999"]
            },
            "description": "El SP devuelve 0 filas afectadas y la API responde 404."
          }
        }
      ]
    }
  ]
}
