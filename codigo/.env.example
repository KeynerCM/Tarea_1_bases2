# Plantilla de variables de entorno. Copiar como .env y completar con valores reales.
# El archivo .env NO se versiona: contiene credenciales.

# Servidor de la API
PORT=3000
NODE_ENV=development

# Conexion a SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=AdventureWorks2025
DB_USER=api_user
DB_PASSWORD=

# Cifrado de la conexion.
# trustServerCertificate=true solo aplica en entorno local con certificado autofirmado.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
